# Upstox API credentials
UPSTOX_ACCESS_TOKEN=your_access_token_here
UPSTOX_CLIENT_ID=your_client_id_here
UPSTOX_CLIENT_SECRET=your_client_secret_here

# Upstox Automatic Login Credentials (Optional for Silent TOTP Authentication)
# UPSTOX_USERNAME=your_mobile_number
# UPSTOX_PASSWORD=your_password
# UPSTOX_PIN_CODE=your_upstox_pin
# UPSTOX_TOTP_SECRET=your_totp_secret_key

# Telegram configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Alert thresholds
BASIS_THRESHOLD=2.0
SPREAD_MIN=0.0
SPREAD_MAX=0.2
BREACH_COUNT_THRESHOLD=5
COOLDOWN_MINUTES=15

# Stock symbols to monitor (comma-separated)
WATCHLIST=RELIANCE,TCS,INFY,HDFCBANK,ICICIBANK
